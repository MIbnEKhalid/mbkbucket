<!-- Move / Rename Modal -->
<div class="modal" id="moveModal" tabindex="-1" aria-labelledby="moveModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="moveModalLabel">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="modal-title-icon"><path d="M11 2L14 5L11 8M14 5H5C3.34315 5 2 6.34315 2 8V14"/></svg>
          <span id="moveModalTitle">Move or Rename</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeMoveModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="moveForm" onsubmit="event.preventDefault(); submitMoveItem();">
          <div class="modal-form-row mb-3">
            <label class="form-label text-muted small">Current Path</label>
            <div class="p-2 rounded text-truncate font-mono small" id="moveSourcePathPreview" style="background: var(--bg-surface-secondary); border: 1px solid var(--border-color); color: var(--dark-color-ml);"></div>
            <input type="hidden" id="moveSourceKeyInput">
            <input type="hidden" id="moveIsCopyInput" value="false">
          </div>
          <div class="modal-form-row mb-3">
            <label for="moveDestNameInput" class="form-label" id="moveDestNameLabel">New Name or Path</label>
            <input type="text" id="moveDestNameInput" class="form-control" autocomplete="off" required>
            <div class="form-text" id="moveHelpText">Enter the new file name or folder destination path.</div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" onclick="closeMoveModal()">Cancel</button>
        <button type="button" class="btn btn-primary" id="submitMoveBtn" onclick="submitMoveItem()">
          <span id="moveSubmitBtnText">Save Changes</span>
        </button>
      </div>
    </div>
  </div>
</div>
