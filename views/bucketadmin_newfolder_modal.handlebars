<!-- New Folder Modal -->
<div class="modal" id="newFolderModal" tabindex="-1" aria-labelledby="newFolderModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="newFolderModalLabel">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="modal-title-icon"><path d="M2 4a1 1 0 011-1h3l2 2h5a1 1 0 011 1v6a1 1 0 01-1 1H3a1 1 0 01-1-1V4z"/><path d="M8 7v4M6 9h4"/></svg>
          New Folder
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeNewFolderModal()">&times;</button>
      </div>
      <div class="modal-body">
        <form id="newFolderForm" onsubmit="event.preventDefault(); submitCreateFolder();">
          <div class="modal-form-row">
            <label for="newFolderNameInput" class="form-label">Folder Name</label>
            <input type="text" id="newFolderNameInput" class="form-control" placeholder="e.g. documents, images, backup" autocomplete="off" required>
            <div class="form-text">Folders are created in the current directory path.</div>
          </div>
        </form>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" onclick="closeNewFolderModal()">Cancel</button>
        <button type="button" class="btn btn-primary" id="submitNewFolderBtn" onclick="submitCreateFolder()">
          Create Folder
        </button>
      </div>
    </div>
  </div>
</div>
