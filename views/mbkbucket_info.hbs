<!DOCTYPE html>
<html lang="en">

{{> head pageTitle="System Information" ogUrl="/mbkbucket/info"}}

<body>
    {{> header appName=APP_NAME customURL="/mbkbucket"}}

    <section class="login-container">
        {{> backgroundElements}}

        <div class="auth-card info-box">
            <div class="info-header">
                <div class="auth-icon-badge" aria-hidden="true">
                    <i class="fas fa-database"></i>
                </div>
                <div>
                    <h1 class="login-title">Storage Diagnostic</h1>
                    <p class="login-subtitle">Runtime storage parameters, active bucket configurations, and version status.</p>
                </div>
            </div>

            <!-- Quick Metrics Grid -->
            <div class="info-stats-grid">
                <div class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-label">MBKBucket Core</span>
                        <div class="stat-icon-wrap"><i class="fas fa-code-branch"></i></div>
                    </div>
                    <div class="stat-value">v<span id="CurrentVersion">{{CurrentVersion}}</span></div>
                    <div class="stat-badge-row">
                        {{#if latestVersion}}
                            {{#if (eq latestVersion CurrentVersion)}}
                            <span class="badge badge-success"><i class="fas fa-check-circle"></i> Up to date</span>
                            {{else}}
                            <span class="badge badge-warning"><i class="fas fa-arrow-up"></i> Update: v{{latestVersion}}</span>
                            {{/if}}
                        {{else}}
                            <span class="badge badge-neutral">v{{CurrentVersion}}</span>
                        {{/if}}
                    </div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-label">Host Application</span>
                        <div class="stat-icon-wrap"><i class="fas fa-cubes"></i></div>
                    </div>
                    <div class="stat-value">{{#if APP_NAME}}{{APP_NAME}}{{else}}mbkbucket{{/if}}</div>
                    <div class="stat-sub-text">Release <code>v{{#if APP_VERSION}}{{APP_VERSION}}{{else}}{{CurrentVersion}}{{/if}}</code></div>
                </div>

                <div class="stat-card">
                    <div class="stat-card-header">
                        <span class="stat-label">Storage Engine</span>
                        <div class="stat-icon-wrap"><i class="fas fa-server"></i></div>
                    </div>
                    <div class="stat-value">
                        <span class="badge badge-success"><i class="fas fa-circle-dot"></i> {{#if providerType}}{{providerType}}{{else}}S3/R2{{/if}}</span>
                    </div>
                    <div class="stat-sub-text">{{#if defaultBucket}}Bucket: <code>{{defaultBucket}}</code>{{else}}Active Storage Engine{{/if}}</div>
                </div>
            </div>

            <!-- Configuration Parameters -->
            <div class="info-section">
                <div class="info-section-header">
                    <h2><i class="fas fa-sliders"></i> Configuration Manifest</h2>
                    <span class="badge badge-neutral">Read-only</span>
                </div>
                
                <div class="info-table-wrap">
                    <table class="info-table">
                        <tbody>
                            <tr>
                                <td class="prop-label"><i class="fas fa-tag"></i> APP_NAME</td>
                                <td class="prop-val"><code>{{#if APP_NAME}}{{APP_NAME}}{{else}}mbkbucket{{/if}}</code></td>
                            </tr>
                            <tr>
                                <td class="prop-label"><i class="fas fa-code-commit"></i> Current Version</td>
                                <td class="prop-val"><code>{{CurrentVersion}}</code></td>
                            </tr>
                            <tr>
                                <td class="prop-label"><i class="fas fa-database"></i> Default Bucket</td>
                                <td class="prop-val"><code>{{#if defaultBucket}}{{defaultBucket}}{{else}}default{{/if}}</code></td>
                            </tr>
                            <tr>
                                <td class="prop-label"><i class="fas fa-layer-group"></i> Configured Buckets</td>
                                <td class="prop-val"><span class="badge badge-neutral">{{#if configuredBucketsCount}}{{configuredBucketsCount}}{{else}}1{{/if}} bucket(s)</span></td>
                            </tr>
                            <tr>
                                <td class="prop-label"><i class="fas fa-eye"></i> Public View Enabled</td>
                                <td class="prop-val">
                                    {{#if (eq mbkbucketVar.publiView_enabled "true")}}
                                    <span class="badge badge-success">true</span>
                                    {{else}}
                                    <span class="badge badge-neutral">{{#if mbkbucketVar.publiView_enabled}}{{mbkbucketVar.publiView_enabled}}{{else}}false{{/if}}</span>
                                    {{/if}}
                                </td>
                            </tr>
                            <tr>
                                <td class="prop-label"><i class="fas fa-file-invoice"></i> Inline View</td>
                                <td class="prop-val">
                                    {{#if (eq mbkbucketVar.p_view_inline "true")}}
                                    <span class="badge badge-success">true</span>
                                    {{else}}
                                    <span class="badge badge-neutral">{{#if mbkbucketVar.p_view_inline}}{{mbkbucketVar.p_view_inline}}{{else}}false{{/if}}</span>
                                    {{/if}}
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Navigation Links -->
            <div class="info-action-grid">
                <a class="btn-outline" href="/mbkbucket"><i class="fas fa-folder-open"></i> File Dashboard</a>
                <a class="btn-outline" href="/mbkbucket/helper-demo"><i class="fas fa-vial"></i> Helper Demo</a>
                <a class="btn-outline" href="/mbkbucket/i.json"><i class="fas fa-code"></i> JSON Diagnostics</a>
                <a class="btn-outline" href="https://github.com/MIbnEKhalid/mbkbucket" target="_blank" rel="noopener noreferrer"><i class="fab fa-github"></i> Repository</a>
            </div>
        </div>
    </section>

    {{> versionInfo}}
</body>
</html>