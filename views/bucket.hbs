<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if page}}{{page}} - {{/if}}Web Portal</title>
    <script src="/mbkauthe/main.js" defer></script>
    <link rel="icon" type="image/x-icon" href="/icon.svg">
    <style>
        :root {
            --primary-color-ml: #0f766e;
            --primary-light-color-ml: #f0fdfa;
            --primary-dark-color-ml: #115e59;
            --secondary-color-ml: #14b8a6;
            --dark-color-ml: #0f172a;
            --light-color-ml: #f8fafc;
            --gray-color-ml: #64748b;
            --gray-light-color-ml: #e2e8f0;
            --danger-color-ml: #ef4444;
            --warning-color-ml: #f59e0b;
            --success-color-ml: #10b981;
            --info-color-ml: #0284c7;

            --primary: var(--primary-color-ml);
            --primary-lt: var(--primary-light-color-ml);
            --primary-dk: var(--primary-dark-color-ml);
            --primary-hover: #134e4a;

            --body-bg: var(--light-color-ml);
            --bg-surface: #ffffff;
            --bg-surface-secondary: #f8fafc;
            --bg-surface-tertiary: #f1f5f9;

            --border-color: #e2e8f0;
            --border-color-light: #f1f5f9;

            --text: var(--dark-color-ml);
            --text-secondary: #475569;
            --text-muted: var(--gray-color-ml);
            --text-disabled: #94a3b8;

            --font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
            --font-family-headings: "Segoe UI", -apple-system, BlinkMacSystemFont, system-ui, Roboto, sans-serif;
            --font-mono: "Segoe UI Mono", "Cascadia Code", Consolas, "Courier New", monospace;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: inherit;
        }

        body, button, input, select, textarea {
            font-family: var(--font-family);
        }

        body {
            font-family: var(--font-family);
            background: var(--body-bg);
            color: var(--text);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
            line-height: 1.5;
            font-size: 14px;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-height: 100vh;
        }

        .top-nav {
            background: #ffffff;
            padding: 0.75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid var(--border-color);
            z-index: 90;
            gap: 1rem;
        }

        .logo {
            font-family: var(--font-family-headings);
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--primary-dk);
            display: flex;
            align-items: center;
            gap: 0.6rem;
            cursor: pointer;
            text-decoration: none;
            letter-spacing: -0.01em;
        }

        .logo img {
            width: 28px;
            height: 28px;
        }

        .content-area {
            flex: 1;
            padding: 1.5rem;
            overflow-y: auto;
        }

        .content-area::-webkit-scrollbar {
            width: 6px;
        }

        .content-area::-webkit-scrollbar-track {
            background: transparent;
        }

        .content-area::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 3px;
        }

        .content-area::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }

        @media (max-width: 768px) {
            .top-nav {
                padding: 0.6rem 1rem;
            }
            .content-area {
                padding: 0.75rem;
            }
        }
    </style>
    {{> showmessage }}
</head>

<body>
    <div class="main-content">
        <nav class="top-nav">
            <div class="logo" onclick="window.location='/mbkbucket'">
                <img src="/icon.svg" alt="Logo">
                <span>MBKBucket</span>
            </div>

            {{> profilemenu }}
        </nav>

        <div class="content-area">
            {{> bucketadmincontent }}
        </div>
    </div>
</body>

</html>