{{!-- Gentelella v4 File Management System - Bucket Dashboard --}}
<link rel="stylesheet" href="/mbkbucket/bucketadmin.css{{mbkbucket_cachebuster}}">
<div id="bucketAppData" data-app-name="{{APP_NAME}}" hidden></div>

<div class="page-wrapper">
  <!-- Page Header -->
  <div class="page-header">
    <div class="page-header-row">
      <div>
        <div class="page-pretitle">Storage &amp; Buckets</div>
        <h1 class="page-title">Files</h1>
      </div>
      <div class="page-actions">
        <button type="button" class="btn btn-outline" id="new-folder-btn" data-action="create-folder">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4a1 1 0 011-1h3l2 2h5a1 1 0 011 1v6a1 1 0 01-1 1H3a1 1 0 01-1-1V4z"/><path d="M8 7v4M6 9h4"/></svg>
          New folder
        </button>
        <button type="button" class="btn btn-primary" id="upload-btn" data-action="upload-files">
          <svg width="15" height="15" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 11v3H2v-3"/><path d="M11 6L8 3 5 6"/><line x1="8" y1="3" x2="8" y2="11"/></svg>
          Upload
        </button>
      </div>
    </div>
  </div>

  {{> bucketadmin_alerts }}

  <!-- Main File Manager Card -->
  <div class="card file-manager">
    <div class="fm-layout">
      <!-- Tree sidebar -->
      <aside class="fm-tree-wrap">
        <div class="fm-tree-header">
          <span class="fm-tree-title">Explorer</span>
        </div>
        <div id="fm-tree" class="fm-tree"></div>

        <div class="fm-storage">
          <div class="fm-storage-label">Connected Bucket</div>
          <div class="bucket-switcher-wrap mb-2">
            <div class="bucket-switcher-control">
              <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" class="bucket-switcher-icon"><path d="M2 4.5C2 3.12 5.13 2 9 2s7 1.12 7 2.5v7c0 1.38-3.13 2.5-7 2.5s-7-1.12-7-2.5v-7z"/><path d="M2 8c0 1.38 3.13 2.5 7 2.5s7-1.12 7-2.5"/></svg>
              <select id="bucketSelector" class="bucket-switcher-select" aria-label="Select connected bucket">
                {{#if bucketOptions.length}}
                  {{#each bucketOptions}}
                    <option value="{{name}}" {{#if isSelected}}selected{{/if}}>{{name}}{{#if isDefault}} (default){{/if}}</option>
                  {{/each}}
                {{else}}
                  <option value="">No buckets configured</option>
                {{/if}}
              </select>
            </div>
            <small id="bucketSwitchStatus" class="bucket-switcher-status is-hidden">Switching bucket...</small>
          </div>
          <div class="storage-bar"><div id="storageUsageBar" style="width: 100%; background: var(--primary);"></div></div>
          <div class="fm-storage-meta d-flex justify-content-between align-items-center">
            <span id="totalFilesCount">Loading...</span>
          </div>
          <div id="filterInfo" class="fm-storage-subinfo"></div>
        </div>
      </aside>

      <!-- Main area -->
      <section class="fm-main">
        <div class="fm-toolbar">
          <nav class="fm-breadcrumb breadcrumb" id="fm-breadcrumb" aria-label="Path"></nav>
          
          <div class="fm-toolbar-actions">
            <!-- Quick filters -->
            <div class="quick-filter-group" role="group" aria-label="Quick filters">
              <button type="button" class="quick-filter-btn active" data-filter="all">All</button>
              <button type="button" class="quick-filter-btn" data-filter="media">Media</button>
              <button type="button" class="quick-filter-btn" data-filter="docs">Docs</button>
              <button type="button" class="quick-filter-btn" data-filter="code">Code</button>
            </div>

            <!-- Search -->
            <div class="search-box">
              <svg class="s-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="7" cy="7" r="5"/><path d="M11 11l3.5 3.5"/></svg>
              <input type="text" id="searchInput" placeholder="Search files…" aria-label="Search files">
              <button type="button" class="search-clear-btn" id="searchClearBtn" style="display: none;" aria-label="Clear search">&times;</button>
            </div>

            <!-- View toggle -->
            <div class="fm-view-toggle">
              <button type="button" class="view-btn active" id="view-grid" aria-label="Grid view" title="Grid view">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/><rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/></svg>
              </button>
              <button type="button" class="view-btn" id="view-list" aria-label="List view" title="List view">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="2" y1="4" x2="14" y2="4"/><line x1="2" y1="8" x2="14" y2="8"/><line x1="2" y1="12" x2="14" y2="12"/></svg>
              </button>
            </div>
          </div>
        </div>

        <!-- File Grid / List Container -->
        <div id="fileListContainer" class="fm-grid-wrap">
          <div id="fm-grid" class="fm-grid view-grid">
            {{> bucketadmin_filelist_skeleton }}
          </div>

          <!-- Empty state -->
          <div id="fm-empty" class="fm-empty" style="display: none;" hidden>
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 7a2 2 0 012-2h4l2 2h7a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/></svg>
            <div class="empty-title">This folder is empty</div>
            <div class="empty-desc">Drag files into the browser or use the Upload button to add files.</div>
            <div class="empty-actions mt-3">
              <button type="button" class="btn btn-outline btn-sm me-2" data-action="create-folder">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 4a1 1 0 011-1h3l2 2h5a1 1 0 011 1v6a1 1 0 01-1 1H3a1 1 0 01-1-1V4z"/><path d="M8 7v4M6 9h4"/></svg>
                New Folder
              </button>
              <button type="button" class="btn btn-primary btn-sm" data-action="upload-files">
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 11v3H2v-3"/><path d="M11 6L8 3 5 6"/><line x1="8" y1="3" x2="8" y2="11"/></svg>
                Upload Files
              </button>
            </div>
          </div>
        </div>

        <!-- Pagination -->
        <div id="paginationContainer" class="pagination-container" style="display: none;">
          <nav aria-label="File pagination">
            <ul class="pagination" id="paginationList"></ul>
          </nav>
        </div>
      </section>
    </div>
  </div>
</div>

{{> bucketadmin_upload_modal }}
{{> bucketadmin_newfolder_modal }}
{{> bucketadmin_delete_modal }}
{{> bucketadmin_preview_modal }}

<!-- Toast Container -->
<div id="toast-container" class="toast-container"></div>

<!-- Context Menu Element -->
<div id="fm-context-menu" class="fm-context-menu" style="display: none;"></div>

<script src="/mbkbucket/bucketadmin.js{{mbkbucket_cachebuster}}"></script>