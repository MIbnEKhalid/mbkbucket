{{!-- File Management System - Bucket Dashboard --}}
<link rel="stylesheet" href="/mbkbucket/bucketadmin.css{{mbkbucket_cachebuster}}">
<div id="bucketAppData" data-app-name="{{APP_NAME}}" hidden></div>
<!-- File Statistics -->
<div class="dashboard-card file-stats reveal-item reveal-delay-1">
  <div class="card-body">
    <div class="stats-content">
      <div class="stats-icon">
        <i class="fas fa-folder"></i>
      </div>
      <div class="stats-text">
        <h2 id="totalFilesCount">Loading...</h2>
        <p id="filterInfo">Loading file information...</p>
      </div>
      <div class="bucket-switcher-wrap">
        <div class="bucket-switcher" role="group" aria-label="Bucket selection">
          <label for="bucketSelector" class="bucket-switcher-label">Active Bucket</label>
          <div class="bucket-switcher-control">
            <i class="fas fa-database bucket-switcher-icon" aria-hidden="true"></i>
            <select id="bucketSelector" class="form-control-sm bucket-switcher-select" aria-label="Select connected bucket">
              {{#if bucketOptions.length}}
                {{#each bucketOptions}}
                  <option value="{{name}}" {{#if isSelected}}selected{{/if}}>{{name}}{{#if isDefault}} (defualt){{/if}}</option>
                {{/each}}
              {{else}}
                <option value="">No buckets configured</option>
              {{/if}}
            </select>
            <i class="fas fa-chevron-down bucket-switcher-caret" aria-hidden="true"></i>
          </div>
          <small id="bucketSwitchStatus" class="bucket-switcher-status is-hidden">Switching bucket...</small>
        </div>
      </div>
    </div>
  </div>
</div>

{{> bucketadmin_alerts }}

<div class="mb-4 reveal-item reveal-delay-2">
  <!-- Upload Form -->
  <div class="col-lg-12">
    <div class="dashboard-card h-100">
      <div class="card-header upload-card-header" id="uploadToggleBtn">
        <h5 class="card-title">
          <div class="card-icon">
            <i class="fas fa-upload"></i>
          </div>
          Upload File
        </h5>
        <button type="button" class="collapse-btn">
          <i class="fas fa-chevron-down"></i>
        </button>
      </div>
      <div class="card-body collapsible-content" id="uploadSection">
        <form id="uploadForm" action="/mbkbucket/upload" method="post" enctype="multipart/form-data">
          <input type="hidden" name="prefix" value="{{prefix}}">

          <div class="mb-3">
            <label for="fileInput" class="form-label">Select Files or drag & drop</label>
            <div id="dropZone" class="upload-drop-zone">
              <div class="drop-zone-content">
                <i class="fas fa-cloud-upload-alt"></i>
                <div class="drop-text">Drop files here or click to browse</div>
                <div class="drop-hint">Supports multiple files</div>
              </div>
            </div>
            <input type="file" class="form-control d-none" id="fileInput" name="files" multiple>
            <div class="form-text">
              <i class="fas fa-info-circle"></i>
              You can drop multiple files. Large files will use chunked upload when available.
            </div>
          </div>

          <!-- Upload Queue -->
          <div id="uploadQueue" class="mb-3"></div>

          <!-- Upload Progress (global fallback) -->
          <div id="uploadProgress" class="mb-3 is-hidden">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="upload-label">Uploading...</span>
              <span id="uploadPercent" class="upload-percent">0%</span>
            </div>
            <div class="progress-container">
              <div id="progressBar" class="progress-bar progress-bar-empty"></div>
            </div>
            <div class="upload-details mt-2">
              <small id="uploadDetails" class="text-muted"></small>
            </div>
          </div>

          <div class="d-grid gap-2 d-md-flex">
            <button type="button" class="btn btn-lg btn-primary" id="startUploadBtn">
              <i class="fas fa-play"></i>
              Start Uploads
            </button>
            <button type="button" class="btn btn-lg btn-primary" id="clearQueueBtn">
              <i class="fas fa-times-circle"></i>
              Clear Queue
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- File List -->
<div class="dashboard-card reveal-item reveal-delay-3">
  <div class="card-header file-list-header">
    <h5 class="card-title">
      <div>
        <i class="fas fa-folder-open"></i>
      </div>
      <span id="fileListTitle">Files</span>
    </h5>

    <!-- Inline Search (moved from separate card) -->
    <div class="search-inline">
      <input type="text" class="form-control form-control-sm" id="searchInput" placeholder="Search files and folders..." aria-label="Search files">
      <button type="button" class="btn btn-sm btn-primary" data-action="search" aria-label="Search"><i class="fas fa-search"></i></button>
      <button type="button" class="btn btn-sm btn-outline-secondary" data-action="clear-search" aria-label="Clear search"><i class="fas fa-times"></i></button>
    </div>

    <div class="quick-filter-group" role="group" aria-label="Quick filters">
      <button type="button" class="btn btn-sm quick-filter-btn active" data-filter="all">All</button>
      <button type="button" class="btn btn-sm quick-filter-btn" data-filter="media">Media</button>
      <button type="button" class="btn btn-sm quick-filter-btn" data-filter="docs">Docs</button>
      <button type="button" class="btn btn-sm quick-filter-btn" data-filter="code">Code</button>
    </div>

    <div class="btn-group" role="group" aria-label="Actions">
      <button type="button" class="btn btn-sm btn-success" data-action="create-file" title="New Text File">
        <i class="fas fa-file-alt"></i> New File
      </button>
      <button type="button" class="btn btn-sm btn-outline-success" data-action="create-folder" title="New Folder">
        <i class="fas fa-folder-plus"></i> New Folder
      </button>
    </div>

    <div class="btn-group" role="group" aria-label="View Mode">
      <button type="button" class="btn btn-sm btn-light view-toggle-btn view-btn-left active" id="viewBtnFolder" data-view-mode="folder" title="Folder View">
        <i class="fas fa-folder"></i> Folders
      </button>
      <button type="button" class="btn btn-sm btn-outline-light view-toggle-btn view-btn-right" id="viewBtnFlat" data-view-mode="flat" title="Flat List (All Files)">
        <i class="fas fa-list-ul"></i> Flat View
      </button>
    </div>
  </div>
  <div class="card-body file-list-card-body">
    <div id="fileListContainer">
      {{> bucketadmin_filelist_skeleton }}
    </div>

    <!-- Pagination -->
    <div id="paginationContainer" class="pagination-container">
      <nav aria-label="File pagination">
        <ul class="pagination" id="paginationList">
        </ul>
      </nav>
    </div>
  </div>
</div>

{{> bucketadmin_delete_modal }}

{{> bucketadmin_preview_modal }}

<!-- Toast Container -->
<div id="toast-container" class="toast-container"></div>

<script src="/mbkbucket/bucketadmin.js{{mbkbucket_cachebuster}}"></script>