{{!-- File Management System - Bucket Dashboard --}}
<link rel="stylesheet" href="/mbkbucket/bucketadmin.css?v={{assetVersion}}">
<div id="bucketAppData" data-app-name="{{APP_NAME}}" hidden></div>
<!-- File Statistics -->
<div class="dashboard-card file-stats">
  <div class="card-body">
    <div class="stats-content">
      <div class="stats-icon">
        <i class="fas fa-folder"></i>
      </div>
      <div class="stats-text">
        <h2 id="totalFilesCount">Loading...</h2>
        <p id="filterInfo">Loading file information...</p>
      </div>
      <div style="margin-left: auto;">
        <span style="background:rgba(255,255,255,0.2); padding:0.35rem 0.75rem; border-radius:0.5rem; font-size:0.85rem; font-weight:600; color:white; letter-spacing:0.02em;">
          <i class="fas fa-database" style="margin-right:0.4rem;"></i>{{bucketvar}}
        </span>
      </div>
    </div>
  </div>
</div>

{{#if message}}
<div class="alert alert-success alert-dismissible fade show" role="alert" id="successAlert">
  <i class="fas fa-check-circle"></i>
  <span id="successMessage">{{message}}</span>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
</div>
{{/if}}

{{#if error}}
<div class="alert alert-danger alert-dismissible fade show" role="alert" id="errorAlert">
  <i class="fas fa-exclamation-triangle"></i>
  <span id="errorMessage">{{error}}</span>
  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close">&times;</button>
</div>
{{/if}}

<div class="mb-4">
  <!-- Upload Form -->
  <div class="col-lg-12">
    <div class="dashboard-card h-100">
      <div class="card-header upload-card-header" id="uploadToggleBtn">
        <h5 class="card-title">
          <div class="card-icon">
            <i class="fas fa-upload"></i>
          </div>
          Upload File
        </h5>
        <button type="button" class="collapse-btn">
          <i class="fas fa-chevron-down"></i>
        </button>
      </div>
      <div class="card-body collapsible-content" id="uploadSection">
        <form id="uploadForm" action="/mbkbucket/upload" method="post" enctype="multipart/form-data">
          <input type="hidden" name="prefix" value="{{prefix}}">

          <div class="mb-3">
            <label for="fileInput" class="form-label">Select Files or drag & drop</label>
            <div id="dropZone" class="upload-drop-zone">
              <div class="drop-zone-content">
                <i class="fas fa-cloud-upload-alt"></i>
                <div class="drop-text">Drop files here or click to browse</div>
                <div class="drop-hint">Supports multiple files</div>
              </div>
            </div>
            <input type="file" class="form-control d-none" style="display: none;" id="fileInput" name="files" multiple>
            <div class="form-text">
              <i class="fas fa-info-circle"></i>
              You can drop multiple files. Large files will use chunked upload when available.
            </div>
          </div>

          <!-- Upload Queue -->
          <div id="uploadQueue" class="mb-3"></div>

          <!-- Upload Progress (global fallback) -->
          <div id="uploadProgress" class="mb-3" style="display: none;">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="upload-label">Uploading...</span>
              <span id="uploadPercent" class="upload-percent">0%</span>
            </div>
            <div class="progress-container">
              <div id="progressBar" class="progress-bar" style="width: 0%;"></div>
            </div>
            <div class="upload-details mt-2">
              <small id="uploadDetails" class="text-muted"></small>
            </div>
          </div>

          <div class="d-grid gap-2 d-md-flex">
            <button type="button" class="btn btn-lg btn-primary" id="startUploadBtn">
              <i class="fas fa-play"></i>
              Start Uploads
            </button>
            <button type="button" class="btn btn-lg btn-primary" id="clearQueueBtn">
              <i class="fas fa-times-circle"></i>
              Clear Queue
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- File List -->
<div class="dashboard-card">
  <div class="card-header file-list-header">
    <h5 class="card-title">
      <div>
        <i class="fas fa-folder-open"></i>
      </div>
      <span id="fileListTitle">Files</span>
    </h5>

    <!-- Inline Search (moved from separate card) -->
    <div class="search-inline">
      <input type="text" class="form-control form-control-sm" id="searchInput" placeholder="Search files and folders..." aria-label="Search files">
      <button type="button" class="btn btn-sm btn-primary" onclick="performSearch()" aria-label="Search"><i class="fas fa-search"></i></button>
      <button type="button" class="btn btn-sm btn-outline-secondary" onclick="clearSearch()" aria-label="Clear search"><i class="fas fa-times"></i></button>
    </div>

    <div class="btn-group" role="group" aria-label="Actions">
      <button type="button" class="btn btn-sm btn-success" onclick="createFile()" title="New Text File">
        <i class="fas fa-file-alt"></i> New File
      </button>
      <button type="button" class="btn btn-sm btn-outline-success" onclick="createFolder()" title="New Folder">
        <i class="fas fa-folder-plus"></i> New Folder
      </button>
    </div>

    <div class="btn-group" role="group" aria-label="View Mode">
      <button type="button" class="btn btn-sm btn-light view-toggle-btn view-btn-left active" id="viewBtnFolder" onclick="changeViewMode('folder')" title="Folder View">
        <i class="fas fa-folder"></i> Folders
      </button>
      <button type="button" class="btn btn-sm btn-outline-light view-toggle-btn view-btn-right" id="viewBtnFlat" onclick="changeViewMode('flat')" title="Flat List (All Files)">
        <i class="fas fa-list-ul"></i> Flat View
      </button>
    </div>
  </div>
  <div class="card-body" style="padding: 0;">
    <div id="fileListContainer">
      <div class="empty-state">
        <i class="fas fa-spinner fa-spin"></i>
        <h4>Loading files...</h4>
        <p>Please wait while we fetch your files.</p>
      </div>
    </div>

    <!-- Pagination -->
    <div id="paginationContainer" class="pagination-container">
      <nav aria-label="File pagination">
        <ul class="pagination" id="paginationList">
        </ul>
      </nav>
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">
          <i class="fas fa-exclamation-triangle"></i>
          Confirm Delete
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"
          onclick="closeModal()">&times;</button>
      </div>
      <div class="modal-body">
        <i class="fas fa-trash-alt fa-3x"></i>
        <h6>Are you sure you want to delete this file?</h6>
        <p class="modal-body-text-style">
          <strong id="deleteFileName" style="color: var(--dark-color-ml);"></strong>
        </p>
        <p class="modal-body-text-top">
          <small>This action cannot be undone.</small>
        </p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" onclick="closeModal()">
          <i class="fas fa-times"></i>
          Cancel
        </button>
        <form id="deleteForm" method="post" action="/mbkbucket/delete" style="display: inline;">
          <input type="hidden" name="key" id="deleteKey">
          <input type="hidden" name="prefix" value="{{prefix}}">
          <input type="hidden" name="folder" id="deleteIsFolder" value="">
          <button type="submit" class="btn btn-danger" id="deleteConfirmButton">
            <i class="fas fa-trash"></i>
            <span id="deleteConfirmLabel">Delete File</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<!-- Preview Modal -->
<div class="modal" id="previewModal" role="dialog" aria-modal="true" aria-labelledby="previewModalLabel" tabindex="-1">
  <div class="modal-dialog preview-modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="previewModalLabel"><i class="fas fa-eye"></i> <span
            id="previewFileName">Preview</span></h5>
        <div class="preview-header-controls">
          <button id="previewFullscreenBtn" class="btn btn-outline-secondary btn-sm" type="button"
            aria-label="Toggle fullscreen"><i class="fas fa-expand"></i></button>
          <button type="button" class="btn-close" aria-label="Close preview" id="previewCloseBtn">&times;</button>
        </div>
      </div>
      <div class="modal-body">
        <div class="preview-content" id="previewContent" aria-live="polite">
          <div class="empty-preview">
            <i class="fas fa-spinner fa-spin"></i>
            <div class="modal-header-spacing">Loading preview...</div>
          </div>
        </div>
      </div>
      <div class="modal-footer preview-footer">
        <div class="preview-actions">
          <a id="previewOpenBtn" class="btn btn-outline-secondary" target="_blank" rel="noopener noreferrer" href="#"><i
              class="fas fa-external-link-alt"></i> Open</a>
          <a id="previewDownloadBtn" class="btn btn-success" download href="#"><i class="fas fa-download"></i>
            Download</a>
          <button type="button" class="btn btn-secondary" id="previewCloseFooter">Close</button>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Toast Container -->
<div id="toast-container" class="toast-container"></div>

<script src="/mbkbucket/bucketadmin.js?v={{assetVersion}}"></script>