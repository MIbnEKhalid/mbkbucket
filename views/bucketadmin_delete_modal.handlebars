<!-- Delete Confirmation Modal -->
<div class="modal" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="deleteModalLabel">
          <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="var(--red)" stroke-width="1.5" class="modal-title-icon"><path d="M3 4h10M6 4V2h4v2M5 4l1 9h4l1-9"/></svg>
          Confirm Delete
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" onclick="closeModal()">&times;</button>
      </div>
      <div class="modal-body text-center py-4">
        <div class="delete-icon-wrap mb-3">
          <svg width="44" height="44" viewBox="0 0 16 16" fill="none" stroke="var(--red)" stroke-width="1.5"><path d="M3 4h10M6 4V2h4v2M5 4l1 9h4l1-9"/></svg>
        </div>
        <h6 class="modal-confirm-heading">Are you sure you want to delete this?</h6>
        <p class="modal-item-name-preview mt-2">
          <code id="deleteFileName"></code>
        </p>
        <p class="text-muted small mt-2">This action cannot be undone.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline" onclick="closeModal()">Cancel</button>
        <form id="deleteForm" method="post" action="/mbkbucket/delete" style="display: inline;">
          <input type="hidden" name="key" id="deleteKey">
          <input type="hidden" name="prefix" value="{{prefix}}">
          <input type="hidden" name="folder" id="deleteIsFolder" value="">
          <button type="submit" class="btn btn-danger" id="deleteConfirmButton">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 4h10M6 4V2h4v2M5 4l1 9h4l1-9"/></svg>
            <span id="deleteConfirmLabel">Delete</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
