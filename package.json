{
  "name": "mbkbucket",
  "version": "4.1.0",
  "description": "Flexible S3/R2/Google Drive/Local bucket management — library, Express router, and standalone server CLI for mbktech.org applications. Provides upload, download, listing, multipart utilities, and a standalone server runner with built-in configuration validation and health checks",
  "author": "Muhammad Bin Khalid",
  "homepage": "https://github.com/MIbnEKhalid/mbkbucket#readme",
  "license": "MIT",
  "main": "index.js",
  "type": "module",
  "types": "index.d.ts",
  "bin": {
    "mbkbucket": "./lib/cli.js"
  },
  "scripts": {
    "start": "node lib/cli.js",
    "dev": "cross-env NODE_ENV=dev node --watch index.js",
    "publish": "node scripts/publish.js",
    "test": "vitest run"
  },
  "imports": {
    "#helpers": "./lib/src/utils/helpers.js",
    "#logger": "./lib/src/utils/logger.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "compression": "^1.8.2",
    "debug": "^4.4.3",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-handlebars": "^9.0.1",
    "express-rate-limit": "^7.5.1",
    "mbkauthe": "^6.2.3",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "@types/supertest": "^7.2.1",
    "cross-env": "^7.0.3",
    "supertest": "^7.3.1",
    "vite": "^8.3.2",
    "vitest": "5.0.3"
  },
  "overrides": {
    "csurf": {
      "cookie": "^0.7.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MIbnEKhalid/mbkbucket.git"
  },
  "bugs": {
    "url": "https://github.com/MIbnEKhalid/mbkbucket/issues"
  },
  "files": [
    "lib",
    "views",
    ".env.example",
    "index.js",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "mbkbucket",
    "s3-bucket",
    "s3",
    "bucket",
    "r2-bucket",
    "bucket-manager",
    "aws-sdk",
    "cloudflare-r2",
    "idrivee2",
    "storage",
    "mbkauthe",
    "mbktech.org",
    "cli",
    "command-line",
    "file-upload",
    "file-download"
  ]
}
