{
  "name": "mbkbucket",
  "version": "3.3.2",
  "description": "Flexible S3/R2 bucket management — library, Express router, and CLI for mbktech.org applications. Provides upload, download, listing, multipart utilities, signed URLs, and a command-line interface with built-in configuration validation and health checks",
  "author": "Muhammad Bin Khalid",
  "homepage": "https://github.com/MIbnEKhalid/mbkbucket#readme",
  "license": "LGPL-3.0-only",
  "main": "index.js",
  "type": "module",
  "types": "index.d.ts",
  "bin": {
    "mbkbucket": "./lib/cli.js"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=dev nodemon index.js",
    "test": "node --test"
  },
  "imports": {
    "#helpers": "./lib/src/utils/helpers.js",
    "#logger": "./lib/src/utils/logger.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.968.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "compression": "^1.8.0",
    "debug": "^4.4.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-handlebars": "^8.0.3",
    "express-rate-limit": "^7.5.0",
    "mbkauthe": "^5.3.6",
    "multer": "^2.0.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "csurf": {
      "cookie": "^0.7.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MIbnEKhalid/mbkbucket.git"
  },
  "bugs": {
    "url": "https://github.com/MIbnEKhalid/mbkbucket/issues"
  },
  "files": [
    "lib",
    "views",
    ".env.example",
    ".mbkbucket.config.example.json",
    "cli.js",
    "index.js",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "mbkbucket",
    "s3-bucket",
    "s3",
    "bucket",
    "r2-bucket",
    "bucket-manager",
    "aws-sdk",
    "cloudflare-r2",
    "idrivee2",
    "storage",
    "mbkauthe",
    "mbktech.org",
    "cli",
    "command-line",
    "file-upload",
    "file-download"
  ]
}