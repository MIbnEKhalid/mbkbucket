<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{#if page}}{{page}} - {{/if}}Web Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <script src="/mbkauthe/main.js" defer></script>
    <script src="https://portal.mbktech.org/Assets/Scripts/auto-ids.js" defer></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="icon" type="image/x-icon" href="/icon.svg">
    <style>
        :root {
            --primary-color-ml: #0f766e;
            --primary-light-color-ml: #d7f4ee;
            --primary-dark-color-ml: #0b4f4a;
            --secondary-color-ml: #1f8f84;
            --dark-color-ml: #1f2a2a;
            --light-color-ml: #f4f7f3;
            --gray-color-ml: #667c79;
            --gray-light-color-ml: #dce8e3;
            --danger-color-ml: #dc2626;
            --warning-color-ml: #d97706;
            --success-color-ml: #16a34a;
            --info-color-ml: #3b82f6;

            --primary: var(--primary-color-ml);
            --primary-lt: var(--primary-light-color-ml);
            --primary-dk: var(--primary-dark-color-ml);
            --primary-hover: #0d635c;

            --body-bg: var(--light-color-ml);
            --bg-surface: rgba(255, 255, 255, 0.88);
            --bg-surface-secondary: rgba(244, 247, 243, 0.7);
            --bg-surface-tertiary: #e9f2ee;

            --border-color: rgba(15, 118, 110, 0.15);
            --border-color-light: rgba(15, 118, 110, 0.08);

            --text: var(--dark-color-ml);
            --text-secondary: #4a5c5a;
            --text-muted: var(--gray-color-ml);
            --text-disabled: #a0b2af;

            --font-family: "IBM Plex Sans", "Segoe UI", sans-serif;
            --font-family-headings: "Sora", "Segoe UI", sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: var(--font-family);
            background:
                radial-gradient(circle at 12% 14%, rgba(16, 185, 129, 0.12), transparent 44%),
                radial-gradient(circle at 86% 8%, rgba(244, 114, 38, 0.12), transparent 40%),
                linear-gradient(160deg, #eef7f2 0, #f8fbf7 52%, #eaf2ef 100%);
            color: var(--dark-color-ml);
            display: flex;
            min-height: 100vh;
            overflow-x: hidden;
            line-height: 1.6;
            font-size: 14px;
            position: relative;
            isolation: isolate;
        }

        body::before,
        body::after {
            content: "";
            position: fixed;
            border-radius: 999px;
            pointer-events: none;
            z-index: -1;
        }

        body::before {
            width: 260px;
            height: 260px;
            left: -80px;
            top: 18vh;
            background: radial-gradient(circle, rgba(15, 118, 110, 0.16) 0, rgba(15, 118, 110, 0) 70%);
        }

        body::after {
            width: 300px;
            height: 300px;
            right: -120px;
            bottom: 10vh;
            background: radial-gradient(circle, rgba(251, 146, 60, 0.18) 0, rgba(251, 146, 60, 0) 72%);
        }

        .main-content {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-height: 100vh;
        }

        .top-nav {
            background: rgba(255, 255, 255, .85);
            backdrop-filter: blur(10px);
            padding: .75rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.06), 0 2px 4px -1px rgba(0, 0, 0, 0.04);
            z-index: 90;
            border-bottom: 1px solid rgba(255, 255, 255, .75);
            gap: 1rem;
        }

        .logo {
            font-family: var(--font-family-headings);
            font-size: 1.5rem;
            font-weight: 700;
            color: #0b4f4a;
            display: flex;
            align-items: center;
            gap: .5rem;
            cursor: pointer;
            text-decoration: none;
        }

        .logo img {
            width: 32px;
            height: 32px;
        }

        .content-area {
            flex: 1;
            padding: 1.5rem;
            overflow-y: auto;
        }

        .content-area::-webkit-scrollbar {
            width: 8px;
        }

        .content-area::-webkit-scrollbar-track {
            background: transparent;
        }

        .content-area::-webkit-scrollbar-thumb {
            background: var(--gray-color-ml);
            border-radius: 4px;
        }

        .content-area::-webkit-scrollbar-thumb:hover {
            background: var(--primary-color-ml);
        }

        @media (max-width: 768px) {
            .top-nav {
                padding: .5rem 1rem;
            }
            .content-area {
                padding: 0.85rem;
            }
        }
    </style>
    {{> showmessage }}
</head>

<body>
    <div class="main-content">
        <nav class="top-nav">
            <div class="logo" onclick="window.location='/mbkbucket'">
                <img src="/icon.svg" alt="Logo">
                <span>MBKBucket</span>
            </div>

            {{> profilemenu }}
        </nav>

        <div class="content-area">
            {{> bucketadmincontent }}
        </div>
    </div>
</body>

</html>